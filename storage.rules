rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function isValidPetImage(fileName) {
      return fileName.matches(
          "^pet-(idle|lie|sleep|eat|cuddle|walk-[1-4])\\.png$"
        )
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == "image/png";
    }

    function isPublicPet(petId) {
      return firestore.get(
        /databases/(default)/documents/pets/$(petId)
      ).data.isPublic == true;
    }

    function isPetOwner(petId) {
      return isGoogleUser()
        && firestore.get(
          /databases/(default)/documents/pets/$(petId)
        ).data.ownerUid == request.auth.uid;
    }

    function isNewUploadOwner(petId) {
      return isGoogleUser()
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.petId == petId;
    }

    function isStoredUploadOwner() {
      return isGoogleUser()
        && resource.metadata.ownerUid == request.auth.uid;
    }

    match /resources/simba/{fileName} {
      allow read;
    }

    match /resources/{petId}/{fileName} {
      allow read: if isPublicPet(petId) || isPetOwner(petId);
      allow create: if resource == null
        && isNewUploadOwner(petId)
        && isValidPetImage(fileName);
      allow delete: if isStoredUploadOwner() || isPetOwner(petId);
    }
  }
}
